{
  "name": "lumina-wealth",
  "version": "0.1.0",
  "private": true,
  "description": "Personal wealth manager with an agent that suggests budget reallocations based on your goals",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "reset": "node -e \"import('./server/store.js').then(m => m.reset())\""
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.1.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  }
}
